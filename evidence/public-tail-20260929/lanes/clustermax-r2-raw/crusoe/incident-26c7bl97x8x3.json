d_at":"2025-08-01T03:44:39.955Z","display_at":"2025-08-01T03:44:39.955Z","deliver_notifications":true,"tweet_id":null,"id":"64ws9t00g0wx","incident_id":"26c7bl97x8x3","custom_tweet":null,"affected_components":[{"code":"jz2913dhyky2","name":"GPU Virtual Machines - us-east1","old_status":"partial_outage","new_status":"partial_outage"}]},{"status":"investigating","body":"We have identified an issue that is preventing new or restarted Virtual Machines from booting successfully on our A100 Infiniband hardware fleet.\n\nAny new VM provisioning request for this hardware type will also fail. Additionally, any existing VM on an A100 Infiniband node that is stopped and started (or rebooted) will also fail to come back online.\n\nExisting, currently running VMs are not affected and will continue to operate normally. We advise customers to avoid rebooting critical workloads on this hardware until a resolution is in place.\n\nOur engineering teams are actively investigating the root cause and are working to restore normal provisioning operations as quickly as possible.","created_at":"2025-08-01T03:18:32.249Z","wants_twitter_update":false,"twitter_updated_at":null,"updated_at":"2025-08-01T03:18:32.249Z","display_at":"2025-08-01T03:18:32.249Z","deliver_notifications":true,"tweet_id":null,"id":"184d7329jxd0","incident_id":"26c7bl97x8x3","custom_tweet":null,"affected_components":[{"code":"jz2913dhyky2","name":"GPU Virtual Machines - us-east1","old_status":"operational","new_status":"partial_outage"}]}],"postmortem_body":null,"postmortem_body_last_updated_at":null,"postmortem_ignored":false,"postmortem_published_at":null,"postmortem_notified_subscribers":false,"postmortem_notified_twitter":false,"components":[{"status":"operational","name":"us-east1","created_at":"2023-11-16T18:33:35.073Z","updated_at":"2026-09-24T19:30:08.351Z","position":1,"description":null,"showcase":true,"start_date":"2023-11-16T00:00:00.000Z","id":"jz2913dhyky2","page_id":"7q522km49wn6","group_id":"0ym6fxn5trdr