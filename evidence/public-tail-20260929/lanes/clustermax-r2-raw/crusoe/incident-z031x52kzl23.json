w_status":"under_maintenance"}]},{"status":"verifying","body":"Work to restore access to the remaining VM's continues, which we expect to be fully recovered by 17:00 UTC.\nWe will continue to post updates every 15 minutes until this is fully resolved.","created_at":"2026-07-16T16:17:43.219Z","wants_twitter_update":false,"twitter_updated_at":null,"updated_at":"2026-07-16T16:17:43.219Z","display_at":"2026-07-16T16:17:43.219Z","deliver_notifications":true,"tweet_id":null,"id":"vs3qk3w238jt","incident_id":"z031x52kzl23","custom_tweet":null,"affected_components":[{"code":"khlcfs3zllmv","name":"Networking - Wide Area Networking (WAN)","old_status":"under_maintenance","new_status":"under_maintenance"},{"code":"47gkyj0hcg8v","name":"Networking - VPC Networking","old_status":"under_maintenance","new_status":"under_maintenance"}]},{"status":"verifying","body":"Maintenance on the FE Leaf switches in us-east1-a is now complete, and VM's in this region are beginning to come back online. We are actively working to restore access to the remaining VM's, which we expect to be fully recovered by 17:00 UTC.\n\nWe will continue to post updates every 15 minutes until this is fully resolved. If you have any questions, please reach out to support@crusoe.ai.","created_at":"2026-07-16T15:52:42.554Z","wants_twitter_update":false,"twitter_updated_at":null,"updated_at":"2026-07-16T15:52:42.554Z","display_at":"2026-07-16T15:52:42.554Z","deliver_notifications":true,"tweet_id":null,"id":"x76k46tn2flh","incident_id":"z031x52kzl23","custom_tweet":null,"affected_components":[{"code":"khlcfs3zllmv","name":"Networking - Wide Area Networking (WAN)","old_status":"under_maintenance","new_status":"under_maintenance"},{"code":"47gkyj0hcg8v","name":"Networking - VPC Networking","old_status":"under_maintenance","new_status":"under_maintenance"}]},{"status":"in_progress","body":"Scheduled maintenance is currently in progress. We will provide updates as necessary.","created_at":"2026-07-16T12:00:07.446Z","wants_twitter_update":false,"twitter_updated_at":null,"updated_at":"2026-07-16T12:00:07.446Z","display_at":"2026-07-16T12:00:07.446Z","deliver_notifications":true,"tweet_id":null,"id":"cm5gy271pmdj","incident_id":"z031x52kzl23","custom_tweet":null,"affected_components":[{"code":"khlcfs3zllmv","name":"Networking - Wide Area Networking (WAN)","old_status":"operational","new_status":"under_maintenance"},{"code":"47gkyj0hcg8v","name":"Networking - VPC Networking","old_status":"operational","new_status":"under_maintenance"}]},{"status":"scheduled","body":"Maintenance will begin as scheduled in 60 minutes.","created_at":"2026-07-16T11:00:10.636Z","wants_twitter_update":false,"twitter_updated_at":null,"updated_at":"2026-07-16T11:00:10.636Z","display_at":"2026-07-16T11:00:10.636Z","deliver_notifications":true,"tweet_id":null,"id":"ff3l53q4wjmk","incident_id":"z031x52kzl23","custom_tweet":null,"affected_components":null},{"status":"scheduled","body":"Update: To ensure a safe and successful maintenance window, we require all customers with active VMs in us-east1-a to shut down their instances prior to the maintenance start time. Any VMs still running at the start of the maintenance window will be shut down by Crusoe on your behalf.\n\nPlease note that shutting down a VM will result in loss of any data stored on ephemeral (local) disks. If you have data on ephemeral storage that you need to retain, please back it up before the maintenance window begins.\n\nPersistent/Shared storage volumes will not be affected by this shutdown process.\n\nIf you have questions or concerns, please reach out to support@crusoe.ai.","created_at":"2026-07-14T16:56:50.040Z","wants_twitter_update":false,"twitter_updated_at":null,"updated_at":"2026-07-14T16:56:50.040Z","display_at":"2026-07-14T16:56:50.040Z","deliver_notifications":true,"tweet_id":null,"id":"l3yjy0p7b5bc","incident_id":"z031x52kzl23","custom_tweet":null,"affected_components":[{"code":"khlcfs3zllmv","name":"Networking - Wide Area Networking (WAN)","old_status":"operational","new_status":"operational"},{"code":"47gkyj0hcg8v","name":"Networking - VPC Networking","old_status":"operational","new_status":"operational"}]},{"status":"scheduled","body":"Crusoe Cloud will be performing planned network maintenance to upgrade Front End (FE) Leaf switches across our global infrastructure. This critical update addresses known software bugs and standardizes our network command-set, significantly improving long-term stability and incident response.\n\nDuring the maintenance window, all hypervisors  in the us-east1-a region will experience intermittent unavailability. We strongly recommend pausing or gracefully shutting down critical workloads during the window to prevent unexpected disruptions or data loss.\n\nAll other services outside the us-east1-a region will remain operational. If you have questions regarding your specific workloads or notice persistent issues following a maintenance window, please reach out to support@crusoe.ai.","created_at":"2026-06-27T04:14:30.797Z","wants_twitter_update":false,"twitter_updated_at":null,"updated_at":"2026-06-27T04:14:30.797Z","display_at":"2026-06-27T04:14:30.797Z","deliver_notifications":true,"tweet_id":null,"id":"52qqdg94b8x7","incident_id":"z031x52kzl23","custom_tweet":null,"affected_components":[{"code":"khlcfs3zllmv","name":"Networking - Wide Area Networking (WAN)","old_status":"operational","new_status":"operational"},{"code":"47gkyj0hcg8v","name":"Networking - VPC Networking","old_status":"operational","new_status":"operational"}]}],"postmortem_body":null,"postmortem_body_last_updated_at":null,"postmortem_ignored":false,"postmortem_published_at":null,"postmortem_notified_subscribers":false,"postmortem_notified_twitter":false,"components":[{"status":"operational","name":"Wide Area Networking (WAN)","created_at":"2023-09-27T21:18:12.999Z","updated_at":"2026-08-18T11:01:34.822Z","position":1,"description":null,"showcase":true,"start_date":"2023-09-27T00:00:00.000Z","id