hot-aisle/** text eol=lf
compute/** text eol=lf
integration/** text eol=lf
corpus/** text eol=lf
# Promoted importer retains the delivered byte identity.
corpus/bulk_import.py -text
shelf/** text eol=lf
*.zip binary

# The app build hashes source bytes and embeds the exact ResearchCore owner.
app/source/** text eol=lf
app/owner-research-core/** -text
app/packets/** -text
app/tests/reproduced-packets/** -text
app/tests/*.py text eol=lf
app/Cantos.html text eol=lf
app/Cantos.manifest.json text eol=lf
index.html text eol=lf

.github/workflows/hot-aisle-ci.yml text eol=lf
.github/workflows/shelf-ci.yml text eol=lf
shelf/data/cards.jsonl -text
shelf/data/staging/** -text
shelf/tests/fixtures/** -text

# Campaign evidence and hashed fixtures must stay byte-identical (MANIFEST.sha256).
hot-aisle/campaign/results/** -text
hot-aisle/campaign/**/fixtures/** -text

# Signed shelf bundles and hashed blind-handoff packets are byte identities.
hot-aisle/campaign/shelf/join/run3-*/** -text
hot-aisle/campaign/shelf/stranger-2-2026-09-24/** -text whitespace=cr-at-eol
